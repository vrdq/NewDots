[Unit]
Description=Sync XWayland and Compositor Cursor (Bibata-Modern-Classic)
PartOf=hyprland-session.target
After=hyprland-session.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'xrdb -merge %h/.Xresources; command -v xsetroot >/dev/null && xsetroot -cursor_name left_ptr; hyprctl setcursor Bibata-Modern-Classic 24'
RemainAfterExit=yes

[Install]
WantedBy=hyprland-session.target
