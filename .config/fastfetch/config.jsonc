{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "data",
        "source": "\u001b[38;2;232;182;240m       /\u005c\n\u001b[38;2;232;182;240m      /  \u005c\n\u001b[38;2;214;192;214m     /    \u005c\n\u001b[38;2;214;192;214m    /      \u005c\n\u001b[38;2;245;183;177m   /   ,,   \u005c\n\u001b[38;2;245;183;177m  /   |  |   \u005c\n\u001b[38;2;245;183;177m /_-''    ''-_\u005c\u001b[0m",
        "padding": {
            "top": 6,
            "right": 3,
            "left": 3
        }
    },
    "display": {
        "separator": " \u001b[38;2;152;142;151m󰇙\u001b[0m ",
        "color": {
            "output": "38;2;234;224;231"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "\u001b[38;2;232;182;240m{user-name}\u001b[0m \u001b[38;2;152;142;151m@\u001b[0m \u001b[38;2;214;192;214m{host-name}\u001b[0m"
        },
        "break",
        {
            "type": "os",
            "key": "\u001b[38;2;232;182;240m \u001b[38;2;207;195;205mos\u001b[0m",
            "keyWidth": 14,
            "format": "{2} {8}"
        },
        {
            "type": "kernel",
            "key": "\u001b[38;2;232;182;240m \u001b[38;2;207;195;205mkernel\u001b[0m",
            "keyWidth": 14,
            "format": "{2}"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;232;182;240m󰦚 \u001b[38;2;207;195;205minstall\u001b[0m",
            "keyWidth": 14,
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "packages",
            "key": "\u001b[38;2;232;182;240m󰏖 \u001b[38;2;207;195;205mpkgs\u001b[0m",
            "keyWidth": 14
        },
        {
            "type": "localip",
            "key": "\u001b[38;2;232;182;240m󰩟 \u001b[38;2;207;195;205mip\u001b[0m",
            "keyWidth": 14,
            "format": "{ipv4}",
            "showPrefixLen": false
        },
        "break",
        {
            "type": "wm",
            "key": "\u001b[38;2;214;192;214m󰈹 \u001b[38;2;207;195;205mwm\u001b[0m",
            "keyWidth": 14,
            "format": "{1} ({3})"
        },
        {
            "type": "shell",
            "key": "\u001b[38;2;214;192;214m󰒉 \u001b[38;2;207;195;205mshell\u001b[0m",
            "keyWidth": 14,
            "format": "{1}"
        },
        {
            "type": "terminal",
            "key": "\u001b[38;2;214;192;214m \u001b[38;2;207;195;205mterm\u001b[0m",
            "keyWidth": 14,
            "format": "{1}"
        },
        {
            "type": "display",
            "key": "\u001b[38;2;214;192;214m󰹍 \u001b[38;2;207;195;205mdisplay\u001b[0m",
            "keyWidth": 14,
            "format": "{4}x{5} @ {3}Hz"
        },
        "break",
        {
            "type": "cpu",
            "key": "\u001b[38;2;245;183;177m󰍛 \u001b[38;2;207;195;205mcpu\u001b[0m",
            "keyWidth": 14,
            "format": "{1}"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;245;183;177m󰆧 \u001b[38;2;207;195;205march\u001b[0m",
            "keyWidth": 14,
            "text": "/lib/ld-linux-x86-64.so.2 --help | awk '/supported, searched/ {print $1; exit}'"
        },
        {
            "type": "gpu",
            "key": "\u001b[38;2;245;183;177m󰢮 \u001b[38;2;207;195;205mgpu\u001b[0m",
            "keyWidth": 14,
            "format": "{2}"
        },
        {
            "type": "memory",
            "key": "\u001b[38;2;245;183;177m󰉿 \u001b[38;2;207;195;205mmemory\u001b[0m",
            "keyWidth": 14,
            "format": "{1} / {2} ({3})"
        },
        {
            "type": "disk",
            "key": "\u001b[38;2;245;183;177m󰉋 \u001b[38;2;207;195;205mdisk\u001b[0m",
            "keyWidth": 14,
            "format": "{1} / {2} ({3}) - {9}",
            "folders": "/"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
