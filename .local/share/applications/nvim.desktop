[Desktop Entry]
Type=Application
Name=Neovim
GenericName=Text Editor
Comment=Edit text files
Exec=kitty --class nvim -e nvim %F
Terminal=false
Categories=Utility;TextEditor;Development;
Keywords=text;editor;code;dev;
Icon=nvim
StartupNotify=true
MimeType=text/plain;text/markdown;text/x-c;text/x-c++;text/x-python;text/x-shellscript;application/x-shellscript;text/x-lua;application/json;application/xml;text/html;text/css;text/javascript;application/javascript;text/x-rust;text/x-java;
